# ===================================================================
# AI-DRIVEN DISASTER MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. Twilio SMS Alerts (Required for SMS dispatch on High Damage)
# Sign up at: https://www.twilio.com/ (Free trial available)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Emergency Officer or Resident Phone Number to receive SMS alerts
ALERT_RECIPIENT_PHONE=+19876543210

# 2. OpenWeatherMap API (Required for live weather & cyclone alerts)
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# 3. Operational Settings
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_LOCATION_NAME=Central Disaster Operational Sector
